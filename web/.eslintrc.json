{
  "extends": ["next/core-web-vitals", "prettier"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["src/lib/logger.ts"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", ".next/", "out/", "next-env.d.ts"]
}
