{
  "manifest_version": 3,
  "name": "NeuroSpace",
  "version": "0.1.0",
  "description": "Gizlilik odaklı odak/yorgunluk analizi. Yazdığınız içerik asla kaydedilmez; yalnızca anonim yazma ritmi metrikleri ölçülür.",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["https://*/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NeuroSpace",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "incognito": "not_allowed"
}
